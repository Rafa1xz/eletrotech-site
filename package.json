{
  "name": "eletrotech-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs --offline",
    "pretest": "npm run build:offline",
    "test": "node --test tests/unit/*.mjs",
    "test:browser": "node tests/browser/navigation.mjs && node tests/browser/catalog.mjs",
    "check": "node scripts/check-source.mjs && node scripts/check-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "studio": "npm --prefix studio run dev --",
    "studio:build": "npm --prefix studio run build --",
    "studio:deploy": "npm --prefix studio run deploy --",
    "sanity:sync": "node scripts/sync-sanity.mjs",
    "cms:bootstrap": "node scripts/export-content.mjs && npm --prefix studio run cms:bootstrap",
    "cms:texts:inventory": "node scripts/inventory-texts.mjs",
    "cms:texts:bootstrap": "npm --prefix studio run cms:texts:bootstrap",
    "cms:layout:bootstrap": "npm --prefix studio run cms:layout:bootstrap",
    "cms:export": "node scripts/export-content.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "cheerio": "^1.1.2",
    "postcss": "^8.5.33",
    "prettier": "3.10.1"
  }
}
